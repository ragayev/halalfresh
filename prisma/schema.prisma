generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  AWAITING_FORWARDING
  FORWARDED
  CONFIRMED_BY_BUTCHER
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  EARNED
  PARTIALLY_REVERSED
  REVERSED
}

enum DeliveryMode {
  REGULAR
  PREORDER_ONLY
}

enum ScheduleKind {
  /// Every week on `weekday`.
  WEEKLY
  /// The `nth` `weekday` of each month (e.g. first Saturday).
  NTH_WEEKDAY_OF_MONTH
}

enum ProductStatus {
  /// Not listed in the storefront (work in progress or temporarily unpublished).
  DRAFT
  /// Listed in the storefront. Purchasable only when also available with a confirmed price.
  ACTIVE
  /// Retired. Kept because old orders reference it; never listed or sold.
  ARCHIVED
}

enum SellingUnit {
  /// Quantity in grams; `pricePerKgCents` is the price per kilogram.
  KG
  /// Quantity unit is 1000 per piece; `pricePerKgCents` is the price of ONE piece.
  PIECE
  /// Quantity unit is 1000 per package (bundles, boxes); `pricePerKgCents` is the price of ONE package.
  PACKAGE
}

/// A partner butcher. MVP has exactly one row; every order points at its merchant
/// so multi-merchant can be added later without reshaping orders.
model Merchant {
  id                String   @id @default(cuid())
  name              String
  legalName         String?
  addressLine       String?
  postalCode        String?
  city              String?
  contactEmail      String?
  contactPhone      String?
  whatsappNumber    String? // digits only, international format, e.g. 4915112345678
  stripeAccountId   String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  settings      MerchantSettings?
  products      Product[]
  supplierArticles SupplierArticle[]
  deliveryZones DeliveryZone[]
  blackoutDates DeliveryBlackoutDate[]
  orders        Order[]
}

model MerchantSettings {
  id                      String   @id @default(cuid())
  merchantId              String   @unique
  merchant                Merchant @relation(fields: [merchantId], references: [id])
  /// Platform commission in basis points (1500 = 15%). Placeholder, not a confirmed agreement.
  commissionBps           Int      @default(1500)
  /// How far ahead (days) the next-delivery search looks. Must cover the longest cycle (monthly = 31+).
  slotHorizonDays         Int      @default(90)
  updatedAt               DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  /// { de: { name }, tr: { name } }
  translations Json      @default("{}")
  imageUrl     String?
  sortOrder    Int       @default(0)
  products     Product[]
}

model Product {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  slug           String   @unique
  name           String
  description    String
  /// { de: { name, description }, tr: { name, description } }
  translations   Json     @default("{}")
  /// Price per kilogram in integer cents.
  pricePerKgCents Int
  /// Orderable increment in grams (500 or 1000 typical).
  stepGrams      Int      @default(1000)
  minGrams       Int      @default(1000)
  maxGrams       Int      @default(20000)
  origin         String?
  /// Only set when the certification is verified by the operator. Shown verbatim.
  halalCertification String?
  allergenInfo   String?
  isAvailable    Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  /// LEGACY MIRROR of `status <> ACTIVE` (enforced by the product_hidden_matches_status CHECK). Decide with `status`.
  isHidden       Boolean  @default(false)
  /// Canonical publishing state. Written only by src/server/product-service.ts.
  status         ProductStatus @default(ACTIVE)
  /// How the product is sold. Quantities stay integers; see src/domain/product-rules.ts for the unit convention.
  sellingUnit    SellingUnit @default(KG)
  /// Can be ordered from preorder-only zones (Ramadan box, Kurban/aqiqah shares).
  preorderEligible Boolean @default(false)
  /// Fleischpaket: [{ grams, names: { de, tr, en }, productSlug? }]. Non-null = bundle sold per package;
  /// quantity unit is 1000 "grams" per package and pricePerKgCents is the price of ONE package (see domain/bundles.ts).
  bundleItems    Json?
  /// false = price is a placeholder; a bundle cannot be made visible until the operator confirms it.
  priceConfirmed Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]
  supplierArticles SupplierArticle[]

  @@index([status, categoryId])
  @@index([categoryId, isAvailable])
  @@index([merchantId])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Either a static path under /public, or null when `data` holds an upload.
  url       String?
  data      Bytes?
  mimeType  String?
  alt       String  @default("")
  position  Int     @default(0)
  /// Generic or illustrative stand-in (not a photo of this exact product). Shown with a notice; flagged in the admin.
  isPlaceholder Boolean @default(false)

  @@index([productId, position])
}

/// A supplier's article number mapped to a product. A product may have several; a number belongs to one product per merchant.
model SupplierArticle {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  supplierSku  String
  /// Name exactly as printed on the supplier list (German).
  originalName String?
  /// Where the mapping came from: "kevser-list", "admin", "csv".
  source       String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([merchantId, supplierSku])
  @@index([productId])
}

model DeliveryZone {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  name       String
  mode       DeliveryMode @default(REGULAR)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  minOrderCents    Int @default(0)
  deliveryFeeCents Int @default(0)
  /// Delivery is free from this merchandise subtotal. null = never free.
  freeDeliveryThresholdCents Int?
  routes     DeliveryRoute[]
  orders     Order[]

  @@index([merchantId])
}

model DeliveryRoute {
  id        String       @id @default(cuid())
  zoneId    String
  zone      DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean      @default(true)
  schedules RouteSchedule[]
  postcodes PostcodeRoute[]
  orders    Order[]

  @@index([zoneId])
}

model RouteSchedule {
  id        String        @id @default(cuid())
  routeId   String
  route     DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  kind      ScheduleKind  @default(WEEKLY)
  /// ISO weekday: 1 = Monday ... 7 = Sunday (Sunday is never delivered).
  weekday   Int
  /// Only for NTH_WEEKDAY_OF_MONTH: 1..5.
  nth       Int?
  windowStart String // "14:00" Europe/Berlin
  windowEnd   String // "18:00"
  /// Order cutoff: hours before the window starts. Whole days are subtracted on the Berlin calendar (DST-stable).
  cutoffHoursBefore Int
  isActive  Boolean       @default(true)

  @@index([routeId])
}

/// One postcode belongs to at most one route. Stored as text to keep leading zeros ("03046").
model PostcodeRoute {
  postcode String        @id
  routeId  String
  route    DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

model DeliveryBlackoutDate {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  date       DateTime @db.Date
  reason     String

  @@unique([merchantId, date])
}

model WaitlistEntry {
  id                String   @id @default(cuid())
  postcode          String
  name              String
  /// Phone or email, as typed.
  contact           String
  preferredLanguage String
  consentGivenAt    DateTime
  createdAt         DateTime @default(now())

  @@index([postcode])
}

model Customer {
  id        String    @id @default(cuid())
  email     String
  name      String
  phone     String
  locale    String    @default("en")
  createdAt DateTime  @default(now())
  addresses Address[]
  orders    Order[]

  @@index([email])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  street     String
  postalCode String
  city       String
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Order {
  id            String @id @default(cuid())
  /// Human-friendly number: HF-<number>. Not an access credential.
  number        Int    @unique @default(autoincrement())
  /// Unguessable token for the customer-facing order page.
  accessToken   String @unique
  /// Client-generated idempotency key for the checkout attempt; prevents duplicate orders on double submit.
  requestId     String? @unique
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  addressId     String
  address       Address  @relation(fields: [addressId], references: [id])
  zoneId        String
  zone          DeliveryZone @relation(fields: [zoneId], references: [id])
  routeId       String?
  route         DeliveryRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  /// Snapshot of the delivery terms at order time (zone rows are editable, orders are not).
  zoneName      String
  deliveryMode  DeliveryMode @default(REGULAR)
  minOrderCents Int          @default(0)
  freeDeliveryThresholdCents Int?
  /// Id of the pre-v2 DeliverySlot this order used (table dropped); traceability only.
  legacySlotId  String?

  /// Calendar date of delivery (UTC midnight of the local date) + snapshot of slot times.
  deliveryDate     DateTime @db.Date
  slotStartTime    String
  slotEndTime      String
  deliveryInstructions String?
  locale           String   @default("en")

  currency            String @default("EUR")
  subtotalCents       Int
  deliveryFeeCents    Int
  totalCents          Int
  commissionBps       Int
  applicationFeeCents Int
  refundedCents       Int    @default(0)

  paymentStatus     PaymentStatus     @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(AWAITING_FORWARDING)

  adminNotes        String?
  forwardedAt       DateTime?
  forwardedBy       String?
  whatsappOpenCount Int       @default(0)
  lastWhatsappOpenAt DateTime?
  paidAt            DateTime?
  /// Set from the verified Stripe webhook once the customer accepted the SEPA mandate and the debit was initiated. NOT money received.
  sepaInitiatedAt   DateTime?
  /// Admin's explicit, audited acceptance of the collection risk so fulfillment may proceed while SEPA is still processing.
  earlyFulfillmentAuthorizedAt DateTime?
  earlyFulfillmentAuthorizedBy String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items      OrderItem[]
  payments   Payment[]
  events     OrderEvent[]
  notifications NotificationLog[]
  commission CommissionRecord?

  @@index([paymentStatus, fulfillmentStatus])
  @@index([createdAt])
  @@index([deliveryDate])
  @@index([merchantId])
}

/// Immutable purchase snapshot.
model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  productSlug      String
  unitPricePerKgCents Int
  quantityGrams    Int
  lineTotalCents   Int
  /// Bundle contents frozen at checkout ({ totalGrams, items }); null for regular products.
  bundleSnapshot   Json?

  @@index([orderId])
}

model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String // PAYMENT_*, FULFILLMENT_*, WHATSAPP_OPENED, FORWARDED, NOTE, REFUND
  fromStatus String?
  toStatus   String?
  note       String?
  actor      String? // admin email or "system"/"stripe"
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id])
  provider              String        @default("stripe")
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  connectedAccountId    String?
  idempotencyKey        String        @unique
  checkoutUrl           String?
  status                PaymentStatus @default(PENDING_PAYMENT)
  amountCents           Int
  applicationFeeCents   Int
  /// Stripe processing fee charged to the connected account, when known.
  stripeFeeCents        Int?
  balanceTransactionId  String?
  failureReason         String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  refunds               Refund[]

  @@index([orderId])
}

model Refund {
  id                    String   @id @default(cuid())
  paymentId             String
  payment               Payment  @relation(fields: [paymentId], references: [id])
  stripeRefundId        String   @unique
  amountCents           Int
  /// Share of the platform commission returned alongside the refund.
  applicationFeeRefundCents Int  @default(0)
  reason                String?
  status                String   @default("succeeded")
  createdAt             DateTime @default(now())

  @@index([paymentId])
}

model CommissionRecord {
  id             String           @id @default(cuid())
  orderId        String           @unique
  order          Order            @relation(fields: [orderId], references: [id])
  merchantId     String
  baseCents      Int // commissionable merchandise + delivery gross
  rateBps        Int
  amountCents    Int
  reversedCents  Int              @default(0)
  status         CommissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String?
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Durable de-duplication of outgoing notifications: one row per (order, kind), claimed before sending.
model NotificationLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@unique([orderId, kind])
}

/// Idempotency ledger for Stripe webhooks.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id
  type        String
  processedAt DateTime @default(now())
}

/// Fixed-window rate limiter that works across serverless instances.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
