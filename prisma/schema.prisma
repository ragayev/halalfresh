generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  AWAITING_FORWARDING
  FORWARDED
  CONFIRMED_BY_BUTCHER
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  EARNED
  PARTIALLY_REVERSED
  REVERSED
}

/// A partner butcher. MVP has exactly one row; every order points at its merchant
/// so multi-merchant can be added later without reshaping orders.
model Merchant {
  id                String   @id @default(cuid())
  name              String
  legalName         String?
  addressLine       String?
  postalCode        String?
  city              String?
  contactEmail      String?
  contactPhone      String?
  whatsappNumber    String? // digits only, international format, e.g. 4915112345678
  stripeAccountId   String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  settings      MerchantSettings?
  products      Product[]
  deliveryZones DeliveryZone[]
  orders        Order[]
}

model MerchantSettings {
  id                      String   @id @default(cuid())
  merchantId              String   @unique
  merchant                Merchant @relation(fields: [merchantId], references: [id])
  minOrderCents           Int      @default(15000)
  deliveryFeeCents        Int      @default(0)
  /// Optional: delivery is free above this merchandise subtotal. null = never free.
  freeDeliveryOverCents   Int?
  /// Platform commission in basis points (1500 = 15%). Placeholder, not a confirmed agreement.
  commissionBps           Int      @default(1500)
  /// Minimum hours between ordering and the earliest bookable slot.
  slotLeadTimeHours       Int      @default(24)
  slotHorizonDays         Int      @default(14)
  updatedAt               DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  /// { de: { name }, tr: { name } }
  translations Json      @default("{}")
  imageUrl     String?
  sortOrder    Int       @default(0)
  products     Product[]
}

model Product {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  slug           String   @unique
  name           String
  description    String
  /// { de: { name, description }, tr: { name, description } }
  translations   Json     @default("{}")
  /// Price per kilogram in integer cents.
  pricePerKgCents Int
  /// Orderable increment in grams (500 or 1000 typical).
  stepGrams      Int      @default(1000)
  minGrams       Int      @default(1000)
  maxGrams       Int      @default(20000)
  origin         String?
  /// Only set when the certification is verified by the operator. Shown verbatim.
  halalCertification String?
  allergenInfo   String?
  isAvailable    Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId, isAvailable])
  @@index([merchantId])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Either a static path under /public, or null when `data` holds an upload.
  url       String?
  data      Bytes?
  mimeType  String?
  alt       String  @default("")
  position  Int     @default(0)

  @@index([productId, position])
}

model DeliveryZone {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  name       String
  isActive   Boolean  @default(true)
  /// Per-zone override of the fee; null uses the merchant default.
  deliveryFeeCents Int?
  postcodes  DeliveryPostcode[]
  slots      DeliverySlot[]
  orders     Order[]

  @@index([merchantId])
}

/// pattern is an exact postcode ("10115") or a prefix ending in * ("101*").
model DeliveryPostcode {
  id      String       @id @default(cuid())
  zoneId  String
  zone    DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pattern String

  @@unique([zoneId, pattern])
}

model DeliverySlot {
  id        String       @id @default(cuid())
  zoneId    String
  zone      DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  /// 0 = Sunday ... 6 = Saturday
  weekday   Int
  startTime String // "10:00"
  endTime   String // "14:00"
  isActive  Boolean      @default(true)
  orders    Order[]

  @@unique([zoneId, weekday, startTime, endTime])
}

model Customer {
  id        String    @id @default(cuid())
  email     String
  name      String
  phone     String
  locale    String    @default("en")
  createdAt DateTime  @default(now())
  addresses Address[]
  orders    Order[]

  @@index([email])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  street     String
  postalCode String
  city       String
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Order {
  id            String @id @default(cuid())
  /// Human-friendly number: HF-<number>. Not an access credential.
  number        Int    @unique @default(autoincrement())
  /// Unguessable token for the customer-facing order page.
  accessToken   String @unique
  /// Client-generated idempotency key for the checkout attempt; prevents duplicate orders on double submit.
  requestId     String? @unique
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  addressId     String
  address       Address  @relation(fields: [addressId], references: [id])
  zoneId        String
  zone          DeliveryZone @relation(fields: [zoneId], references: [id])
  slotId        String
  slot          DeliverySlot @relation(fields: [slotId], references: [id])

  /// Calendar date of delivery (UTC midnight of the local date) + snapshot of slot times.
  deliveryDate     DateTime @db.Date
  slotStartTime    String
  slotEndTime      String
  deliveryInstructions String?
  locale           String   @default("en")

  currency            String @default("EUR")
  subtotalCents       Int
  deliveryFeeCents    Int
  totalCents          Int
  commissionBps       Int
  applicationFeeCents Int
  refundedCents       Int    @default(0)

  paymentStatus     PaymentStatus     @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(AWAITING_FORWARDING)

  adminNotes        String?
  forwardedAt       DateTime?
  forwardedBy       String?
  whatsappOpenCount Int       @default(0)
  lastWhatsappOpenAt DateTime?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items      OrderItem[]
  payments   Payment[]
  events     OrderEvent[]
  commission CommissionRecord?

  @@index([paymentStatus, fulfillmentStatus])
  @@index([createdAt])
  @@index([deliveryDate])
  @@index([merchantId])
}

/// Immutable purchase snapshot.
model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  productSlug      String
  unitPricePerKgCents Int
  quantityGrams    Int
  lineTotalCents   Int

  @@index([orderId])
}

model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String // PAYMENT_*, FULFILLMENT_*, WHATSAPP_OPENED, FORWARDED, NOTE, REFUND
  fromStatus String?
  toStatus   String?
  note       String?
  actor      String? // admin email or "system"/"stripe"
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id])
  provider              String        @default("stripe")
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  connectedAccountId    String?
  idempotencyKey        String        @unique
  checkoutUrl           String?
  status                PaymentStatus @default(PENDING_PAYMENT)
  amountCents           Int
  applicationFeeCents   Int
  /// Stripe processing fee charged to the connected account, when known.
  stripeFeeCents        Int?
  balanceTransactionId  String?
  failureReason         String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  refunds               Refund[]

  @@index([orderId])
}

model Refund {
  id                    String   @id @default(cuid())
  paymentId             String
  payment               Payment  @relation(fields: [paymentId], references: [id])
  stripeRefundId        String   @unique
  amountCents           Int
  /// Share of the platform commission returned alongside the refund.
  applicationFeeRefundCents Int  @default(0)
  reason                String?
  status                String   @default("succeeded")
  createdAt             DateTime @default(now())

  @@index([paymentId])
}

model CommissionRecord {
  id             String           @id @default(cuid())
  orderId        String           @unique
  order          Order            @relation(fields: [orderId], references: [id])
  merchantId     String
  baseCents      Int // commissionable merchandise + delivery gross
  rateBps        Int
  amountCents    Int
  reversedCents  Int              @default(0)
  status         CommissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String?
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Idempotency ledger for Stripe webhooks.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id
  type        String
  processedAt DateTime @default(now())
}

/// Fixed-window rate limiter that works across serverless instances.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
