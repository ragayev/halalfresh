generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  WEIGHED
  PAYMENT_OVERDUE
  PAID
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERED_UNPAID
  CASH_COLLECTED
  REFUSED_AT_DOOR
  CANCELLED
}

enum PaymentMethod {
  PAYPAL
  CASH
}

/// CAPTURE_AFTER_WEIGH is the MVP. AUTHORIZE_THEN_CAPTURE is reserved for the later auth/capture + marketplace-fee flow.
enum PaymentMode {
  CAPTURE_AFTER_WEIGH
  AUTHORIZE_THEN_CAPTURE
}

enum PaymentRecordStatus {
  CREATED
  APPROVED
  PENDING
  COMPLETED
  DENIED
  VOIDED
  REFUNDED
}

enum ConsentType {
  MARKETING
  DATA_TRANSFER
  TERMS
}

enum DeliveryMode {
  REGULAR
  PREORDER_ONLY
}

enum ScheduleKind {
  /// Every week on `weekday`.
  WEEKLY
  /// The `nth` `weekday` of each month (e.g. first Saturday).
  NTH_WEEKDAY_OF_MONTH
}

enum ProductStatus {
  /// Not listed in the storefront (work in progress or temporarily unpublished).
  DRAFT
  /// Listed in the storefront. Purchasable only when also available with a confirmed price.
  ACTIVE
  /// Retired. Kept because old orders reference it; never listed or sold.
  ARCHIVED
}

enum SellingUnit {
  /// Quantity in grams; `pricePerKgCents` is the price per kilogram.
  KG
  /// Quantity unit is 1000 per piece; `pricePerKgCents` is the price of ONE piece.
  PIECE
  /// Quantity unit is 1000 per package (bundles, boxes); `pricePerKgCents` is the price of ONE package.
  PACKAGE
}

/// A partner butcher. MVP has exactly one row; every order points at its merchant
/// so multi-merchant can be added later without reshaping orders.
model Merchant {
  id             String   @id @default(cuid())
  name           String
  legalName      String?
  addressLine    String?
  postalCode     String?
  city           String?
  contactEmail   String?
  contactPhone   String?
  whatsappNumber String? // digits only, international format, e.g. 4915112345678
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  settings         MerchantSettings?
  products         Product[]
  supplierArticles SupplierArticle[]
  deliveryZones    DeliveryZone[]
  blackoutDates    DeliveryBlackoutDate[]
  orders           Order[]
}

model MerchantSettings {
  id              String   @id @default(cuid())
  merchantId      String   @unique
  merchant        Merchant @relation(fields: [merchantId], references: [id])
  /// How far ahead (days) the next-delivery search looks. Must cover the longest cycle (monthly = 31+).
  slotHorizonDays Int      @default(90)
  updatedAt       DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  /// { de: { name }, tr: { name } }
  translations Json      @default("{}")
  imageUrl     String?
  sortOrder    Int       @default(0)
  products     Product[]
}

model Product {
  id                 String        @id @default(cuid())
  merchantId         String
  merchant           Merchant      @relation(fields: [merchantId], references: [id])
  categoryId         String
  category           Category      @relation(fields: [categoryId], references: [id])
  slug               String        @unique
  name               String
  description        String
  /// { de: { name, description }, tr: { name, description } }
  translations       Json          @default("{}")
  /// Price per kilogram in integer cents.
  pricePerKgCents    Int
  /// Orderable increment in grams (500 or 1000 typical).
  stepGrams          Int           @default(1000)
  minGrams           Int           @default(1000)
  maxGrams           Int           @default(20000)
  origin             String?
  /// Only set when the certification is verified by the operator. Shown verbatim.
  halalCertification String?
  allergenInfo       String?
  isAvailable        Boolean       @default(true)
  isFeatured         Boolean       @default(false)
  /// LEGACY MIRROR of `status <> ACTIVE` (enforced by the product_hidden_matches_status CHECK). Decide with `status`.
  isHidden           Boolean       @default(false)
  /// Canonical publishing state. Written only by src/server/product-service.ts.
  status             ProductStatus @default(ACTIVE)
  /// How the product is sold. Quantities stay integers; see src/domain/product-rules.ts for the unit convention.
  sellingUnit        SellingUnit   @default(KG)
  /// Can be ordered from preorder-only zones (Ramadan box, Kurban/aqiqah shares).
  preorderEligible   Boolean       @default(false)
  /// Fleischpaket: [{ grams, names: { de, tr, en }, productSlug? }]. Non-null = bundle sold per package;
  /// quantity unit is 1000 "grams" per package and pricePerKgCents is the price of ONE package (see domain/bundles.ts).
  bundleItems        Json?
  /// false = price is a placeholder; a bundle cannot be made visible until the operator confirms it.
  priceConfirmed     Boolean       @default(true)
  sortOrder          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  images           ProductImage[]
  orderItems       OrderItem[]
  supplierArticles SupplierArticle[]

  @@index([status, categoryId])
  @@index([categoryId, isAvailable])
  @@index([merchantId])
  @@index([isFeatured])
}

model ProductImage {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Either a static path under /public, or null when `data` holds an upload.
  url           String?
  data          Bytes?
  mimeType      String?
  alt           String  @default("")
  position      Int     @default(0)
  /// Generic or illustrative stand-in (not a photo of this exact product). Shown with a notice; flagged in the admin.
  isPlaceholder Boolean @default(false)

  @@index([productId, position])
}

/// A supplier's article number mapped to a product. A product may have several; a number belongs to one product per merchant.
model SupplierArticle {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  supplierSku  String
  /// Name exactly as printed on the supplier list (German).
  originalName String?
  /// Where the mapping came from: "kevser-list", "admin", "csv".
  source       String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([merchantId, supplierSku])
  @@index([productId])
}

model DeliveryZone {
  id                         String          @id @default(cuid())
  merchantId                 String
  merchant                   Merchant        @relation(fields: [merchantId], references: [id])
  name                       String
  mode                       DeliveryMode    @default(REGULAR)
  isActive                   Boolean         @default(true)
  sortOrder                  Int             @default(0)
  minOrderCents              Int             @default(0)
  deliveryFeeCents           Int             @default(0)
  /// Delivery is free from this merchandise subtotal. null = never free.
  freeDeliveryThresholdCents Int?
  routes                     DeliveryRoute[]
  orders                     Order[]

  @@index([merchantId])
}

model DeliveryRoute {
  id        String          @id @default(cuid())
  zoneId    String
  zone      DeliveryZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean         @default(true)
  schedules RouteSchedule[]
  postcodes PostcodeRoute[]
  orders    Order[]

  @@index([zoneId])
}

model RouteSchedule {
  id                String        @id @default(cuid())
  routeId           String
  route             DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  kind              ScheduleKind  @default(WEEKLY)
  /// ISO weekday: 1 = Monday ... 7 = Sunday (Sunday is never delivered).
  weekday           Int
  /// Only for NTH_WEEKDAY_OF_MONTH: 1..5.
  nth               Int?
  windowStart       String // "14:00" Europe/Berlin
  windowEnd         String // "18:00"
  /// Order cutoff: hours before the window starts. Whole days are subtracted on the Berlin calendar (DST-stable).
  cutoffHoursBefore Int
  isActive          Boolean       @default(true)

  @@index([routeId])
}

/// One postcode belongs to at most one route. Stored as text to keep leading zeros ("03046").
model PostcodeRoute {
  postcode String        @id
  routeId  String
  route    DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

model DeliveryBlackoutDate {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  date       DateTime @db.Date
  reason     String

  @@unique([merchantId, date])
}

model WaitlistEntry {
  id                String   @id @default(cuid())
  postcode          String
  name              String
  /// Phone or email, as typed.
  contact           String
  preferredLanguage String
  /// waitlist = known postcode outside the delivery area; unknown = postcode not in our data.
  reason            String   @default("waitlist")
  consentGivenAt    DateTime
  createdAt         DateTime @default(now())

  @@index([postcode])
}

model Customer {
  id           String   @id @default(cuid())
  /// Identity: phone normalised to E.164.
  phoneE164    String   @unique
  email        String
  firstName    String
  lastName     String
  /// Orders refused at the door. Cash is blocked while > 0. Retained 2 years.
  refusedCount Int      @default(0)
  /// Manual admin override.
  blockedCash  Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders    Order[]
  consents  Consent[]
  addresses Address[]

  @@index([email])
}

model Consent {
  id             String      @id @default(cuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  orderId        String?
  type           ConsentType
  wordingVersion String
  granted        Boolean
  createdAt      DateTime    @default(now())

  @@index([customerId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  street     String
  postalCode String
  city       String
  notes      String?
  createdAt  DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  /// Display number: HF-000123 (zero-padded). Not an access credential.
  number      Int      @unique @default(autoincrement())
  /// Unguessable token (>= 128 bit, URL-safe) for /b/{token}.
  publicToken String   @unique
  /// Client-generated idempotency key for the checkout attempt.
  requestId   String?  @unique
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])

  street        String
  postalCode    String
  city          String
  deliveryNotes String?

  /// Legacy DB-managed zone; null for orders placed under the static postcode data (src/data/delivery).
  zoneId        String?
  zone          DeliveryZone?  @relation(fields: [zoneId], references: [id])
  routeId       String?
  route         DeliveryRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  zoneName      String
  /// core | tier_100 | tier_150 and, outside core, west | north | northeast | southeast | southwest. Internal only.
  tier          String?
  sector        String?
  /// The postcode was flagged needs_review in the overrides file when the order was placed.
  zoneNeedsReview Boolean      @default(false)
  deliveryMode  DeliveryMode   @default(REGULAR)
  deliveryDate  DateTime       @db.Date
  slotStartTime String
  slotEndTime   String
  locale        String         @default("de")

  status        OrderStatus   @default(NEW)
  paymentMethod PaymentMethod
  paymentMode   PaymentMode   @default(CAPTURE_AFTER_WEIGH)

  /// Rules snapshotted at order time.
  toleranceBps        Int
  minOrderCents       Int  @default(0)
  deliveryFeeCents    Int
  estimatedTotalCents Int
  maxTotalCents       Int
  finalTotalCents     Int?
  /// Final weighed amount as reported by Kevser over WhatsApp (admin entry). Informational; payment uses finalTotalCents.
  reportedFinalCents  Int?
  /// final items total minus max items total when the tolerance cap applied (absorbed by the seller).
  cappedAmountCents   Int?
  paidAmountCents     Int?
  refundedCents       Int  @default(0)
  /// Reserved for the marketplace model.
  commissionBps       Int?
  commissionCents     Int?

  cancelReason String?
  notes        String?
  adminNotes   String?
  refusedAt    DateTime?
  acceptedAt   DateTime?
  weighedAt    DateTime?
  paidAt       DateTime?
  /// Set when the order reaches a terminal state; the public link expires a configurable time after.
  terminalAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items            OrderItem[]
  payments         Payment[]
  events           OrderEvent[]
  notifications    Notification[]
  notificationLogs NotificationLog[]

  @@index([status, deliveryDate])
  @@index([createdAt])
  @@index([customerId])
  @@index([merchantId])
}

/// Order line. Name and price are snapshots; grams/prices follow the pricing rules in src/domain/pricing.ts.
model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName         String
  productSlug         String
  unitPricePerKgCents Int
  requestedGrams      Int
  estimatedCents      Int
  /// null until weighed; 0 = item unavailable.
  actualGrams         Int?
  finalCents          Int?
  /// Tags lines that came from expanding a bundle (analytics only).
  bundleId            String?

  @@index([orderId])
}

/// Append-only audit log of every state change.
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  /// customer | admin | system | webhook
  actor      String
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id])
  provider          String              @default("paypal")
  providerOrderId   String?             @unique
  providerCaptureId String?             @unique
  amountCents       Int
  status            PaymentRecordStatus @default(CREATED)
  idempotencyKey    String              @unique
  /// Raw provider responses, for debugging.
  raw               Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderId])
}

model Notification {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// email | sms | telegram
  channel           String
  template          String
  recipient         String
  /// pending | sent | failed
  status            String
  providerMessageId String?
  error             String?
  createdAt         DateTime @default(now())

  @@index([orderId])
  /// One row per (order, channel, template) may be claimed to de-duplicate automatic sends.
  @@index([orderId, channel, template])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Base32 TOTP secret; null = not enrolled.
  totpSecret   String?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String?
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Durable de-duplication of outgoing notifications: one row per (order, kind), claimed before sending.
model NotificationLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@unique([orderId, kind])
}

/// Idempotency ledger for PayPal webhooks.
model ProcessedWebhookEvent {
  id          String   @id // PayPal event id
  type        String
  processedAt DateTime @default(now())
}

/// Fixed-window rate limiter that works across serverless instances.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
